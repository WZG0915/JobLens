# 将本文件复制为 .env，再在本机填写配置。
# 不要提交 .env 或任何真实 API Key。
# 只有命令显式包含 --provider openai 时，程序才会调用外部 API。
# 支持 openai、deepseek；其他 OpenAI 兼容服务需同时填写 LLM_BASE_URL。
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
# deepseek 可留空，程序会自动使用 https://api.deepseek.com。
LLM_BASE_URL=

# 本地 RAG 配置；首次使用会下载 BGE 模型，后续可以只读本地缓存。
JOBLENS_BGE_MODEL=BAAI/bge-small-zh-v1.5
JOBLENS_BGE_DEVICE=auto
JOBLENS_BGE_BATCH_SIZE=32
JOBLENS_BGE_LOCAL_ONLY=0
